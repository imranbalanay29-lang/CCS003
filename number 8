#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main()
{
    double t1, t2, t3 ;
    double average;
    double diff ;
    
    cout << "Enter t1: " ;
    cin >> t1;
    
    cout << "Enter t2: " ;
    cin >> t2 ;
    
    cout << "Enter t3: " ;
    cin >> t3 ;
    
    average = (t1 + t2 + t3) / 3.0 ;
    diff = fabs(t1 - t3) ;
   
    cout << fixed << setprecision(3);
    cout << "average: " << average <<endl ;
    cout << "|T1-T3|" << diff <<endl;
    cout << "floor: " << floor(average) <<endl;
    cout << "ceil: " << ceil(average) <<endl;
    cout << "trunc: " << trunc(average) <<endl;
    cout << "round: " << round(average) <<endl;
    

    return 0;
}
