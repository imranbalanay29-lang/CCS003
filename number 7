#include <iostream>
#include <cmath>

using namespace std;

int main()
{
   double x1, y1, x2, y2 ;
   double finalDistance ;
   
   cout << "Enter x1: " ;
   cin >> x1 ;
   
   cout << "Enter y1: " ;
   cin >> y1 ;
   
   cout << "Enter y2: " ;
   cin >> x2 ;
   
   cout << "Enter x2: " ;
   cin >> y2 ;
   
   double dx = (x2 - x1) ;
   double dy = (y2 - y1) ;
   finalDistance = sqrt(pow(dx,2) + pow(dy,2)) ;
   
   cout << "dx: " << dx <<endl ;
   cout << "dy: " << dy <<endl ;
   cout << "final distance: " << finalDistance <<endl;




    return 0;
}
